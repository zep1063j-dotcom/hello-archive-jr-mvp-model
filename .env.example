# Hello Archive jr 환경 변수 템플릿
# 이 파일을 .env.local 로 복사해 값을 채운다. .env.local 은 Git에 올리지 않는다.
# 실제 비밀키 값을 이 파일에 적지 않는다.

# --- Supabase (SESSION 02~03에서 사용) ---
# 브라우저에 공개되어도 되는 값 (RLS가 보호한다)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 서버 전용. 절대 NEXT_PUBLIC_ 접두사를 붙이지 않는다. (SESSION 07 이메일 발송 작업에서만 사용)
SUPABASE_SERVICE_ROLE_KEY=

# --- 앱 주소 (인증 리다이렉트, 이메일 링크 생성에 사용) ---
# 로컬: http://localhost:3000 / 배포: 실제 HTTPS 주소 (SESSION 07 이메일 링크용. 코드 방식 로그인은 쓰지 않는다)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- 이메일 (SESSION 07, 주간 질문 메일) ---
# Resend API 키 (서버 전용). 인증 메일용 SMTP(Supabase 대시보드 설정)와 별개로 앱 서버가 주간 메일을 보낼 때 쓴다.
RESEND_API_KEY=
# 발신 주소. 예: "Hello Archive jr <onboarding@resend.dev>" (도메인 인증 전에는 Resend 테스트 발신 주소, 가입 이메일에만 발송됨)
EMAIL_FROM=

# --- 공개 화면 방문 측정 GA4 (D-035). 비워 두면 측정하지 않는다. 공개 값이라 Vercel에서 Sensitive를 끈다. 값은 GA4 측정 ID(G-로 시작)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- 예약 실행 보호 (SESSION 07). 충분히 긴 무작위 문자열. Vercel에 같은 이름으로 등록하면 크론이 Bearer로 보낸다 ---
CRON_SECRET=
