# Hello Archive jr 환경 변수 템플릿
# 이 파일을 .env.local 로 복사해 값을 채운다. .env.local 은 Git에 올리지 않는다.
# 실제 비밀키 값을 이 파일에 적지 않는다.

# --- Supabase (SESSION 02~03에서 사용) ---
# 브라우저에 공개되어도 되는 값 (RLS가 보호한다)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 서버 전용. 절대 NEXT_PUBLIC_ 접두사를 붙이지 않는다. (SESSION 07 이메일 발송 작업에서만 사용)
SUPABASE_SERVICE_ROLE_KEY=

# --- 앱 주소 (인증 리다이렉트, 이메일 링크 생성에 사용) ---
# 로컬: http://localhost:3000 / 배포: 실제 HTTPS 주소
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- 이메일 (SESSION 07에서 사용) ---
RESEND_API_KEY=
EMAIL_FROM=

# --- 예약 실행 보호 (SESSION 07). 충분히 긴 무작위 문자열 ---
CRON_SECRET=
